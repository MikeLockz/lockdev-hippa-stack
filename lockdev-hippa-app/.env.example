# HIPAA-Compliant Healthcare API Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hipaa_api
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/hipaa_test

# =============================================================================
# AUTHENTICATION PROVIDER CONFIGURATION
# =============================================================================

# Provider Selection - Choose one: custom, aws_cognito, auth0, supabase
AUTH_PROVIDER_TYPE=custom

# =============================================================================
# CUSTOM PROVIDER (JWT-based) CONFIGURATION
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# AWS COGNITO PROVIDER CONFIGURATION
# =============================================================================
AWS_COGNITO_USER_POOL_ID=us-east-1_example
AWS_COGNITO_CLIENT_ID=your-cognito-client-id
AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# =============================================================================
# AUTH0 PROVIDER CONFIGURATION
# =============================================================================
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# =============================================================================
# SUPABASE PROVIDER CONFIGURATION
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# HIPAA COMPLIANCE SETTINGS
# =============================================================================

# Security Policies
REQUIRE_MFA=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=480  # 8 hours for healthcare workers
IDLE_TIMEOUT_MINUTES=15

# Password Policies
MIN_PASSWORD_LENGTH=12
REQUIRE_PASSWORD_COMPLEXITY=true
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=12

# PHI Access Controls
PHI_ACCESS_DEFAULT_DURATION_HOURS=24
REQUIRE_PHI_ACCESS_REASON=true
PHI_ACCESS_EXPIRY_WARNING_DAYS=7

# Audit and Logging
AUDIT_ALL_EVENTS=true
AUDIT_RETENTION_DAYS=2555  # 7 years HIPAA requirement
ENABLE_AUDIT_ENCRYPTION=true
LOG_PHI_ACCESS=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# SSL/TLS
FORCE_HTTPS=true
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Prometheus Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Health Checks
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=5

# Logging
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/hipaa-api/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Error Reporting
SENTRY_DSN=your-sentry-dsn
ERROR_REPORTING_ENABLED=true

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# Email Templates
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=HIPAA Healthcare API

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Slack Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#security-alerts

# SMS Notifications (for MFA)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Business Associate Agreement (BAA) Compliance
BAA_COMPLIANCE_ENABLED=true
BAA_VENDOR_NAME=Your Healthcare Organization
BAA_EFFECTIVE_DATE=2024-01-01

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development overrides (use with caution)
SKIP_MFA_IN_DEV=false
ENABLE_SWAGGER_DOCS=true
DEBUG_SQL=false
MOCK_EXTERNAL_SERVICES=false

# =============================================================================
# TESTING SETTINGS
# =============================================================================

# Test configuration overrides
TEST_JWT_SECRET=test-secret-key-for-testing-only
TEST_USER_PASSWORD=TestPassword123!
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/hipaa_test
ENABLE_TEST_ENDPOINTS=false

# =============================================================================
# PRODUCTION HARDENING
# =============================================================================

# Production Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Content Security Policy
CSP_ENABLED=true
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

# Referrer Policy
REFERERRER_POLICY="strict-origin-when-cross-origin"

# =============================================================================
# LEGACY COMPATIBILITY
# =============================================================================

# Legacy auth settings (for migration period)
LEGACY_AUTH_ENABLED=false
LEGACY_JWT_SECRET=legacy-secret-for-migration-only
MIGRATION_BATCH_SIZE=100

# =============================================================================
# NOTES
# =============================================================================

# SECURITY REMINDERS:
# 1. Never commit real secrets to version control
# 2. Use environment-specific .env files (e.g., .env.production)
# 3. Rotate secrets regularly
# 4. Use AWS Secrets Manager or similar for production
# 5. Ensure all PHI data is encrypted at rest and in transit
# 6. Regular security audits and penetration testing
# 7. Business Associate Agreement (BAA) with all third-party services

# HIPAA COMPLIANCE CHECKLIST:
# ✅ Data encryption at rest and in transit
# ✅ Role-based access control (RBAC)
# ✅ Multi-factor authentication (MFA)
# ✅ Comprehensive audit logging
# ✅ Session management and timeouts
# ✅ Password policies enforced
# ✅ Regular security assessments
# ✅ Incident response procedures
# ✅ Data backup and recovery procedures
# ✅ Employee training and awareness